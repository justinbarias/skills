      "css": ".ds-row{font-family:'Albert Sans',system-ui,sans-serif;display:grid;grid-template-columns:20px 6ch 1fr;gap:12px;align-items:center;width:360px;min-height:54px;padding:10px 8px;border-top:2px solid #0b1f3a;border-bottom:1px solid #c9d2df;color:#0b1f3a;font-size:15px} .ds-row:hover{background:#f1f4f8} .ds-row b{font-size:17px} .ds-row small{display:block;color:#42546f;font-size:13px}"
