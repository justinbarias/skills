      "description": "A plan segment with stops, a waiting casing, and a gate station.",
      "html": "<div class=\"ds-line\"><div class=\"ds-track\"></div><div class=\"ds-casing\"></div><span class=\"ds-knob\"></span></div>",
      "css": ".ds-line{position:relative;width:280px;padding:6px 0 20px}.ds-track{height:12px;background:#0057b8;border-radius:6px 0 0 6px}.ds-casing{height:12px;margin-top:10px;background:color-mix(in srgb,#c08800 22%,#fff);box-shadow:inset 0 0 0 2.5px #c08800}.ds-knob{position:absolute;right:0;top:6px;width:24px;height:24px;border-radius:50%;background:#fff;border:4.5px solid #0b1f3a}"
    },
