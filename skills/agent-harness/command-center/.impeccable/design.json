  "narrative": {
    "northStar": "Line Diagram",
    "overview": "The page reads like a transit map. Each plan is a colored line. Each task is a stop on that line. Each gate is an interchange station. A red marker shows where the project stands now.\n\nBelow the diagram, the page reads like a printed timetable. Rows sit between rules, with no cards and no boxes. A navy rail at the left holds the line list, like a station sign.\n\nThe system is plain and exact. Ink is navy, not black. Color belongs to the lines and to one signal red. Type is one family at a few sizes.",
    "keyCharacteristics": [
      "One typeface, Albert Sans, embedded in the file, with tabular numerals everywhere.",
      "Eight line colors give each plan an identity. They carry no meaning beyond identity.",
      "Signal red marks the position marker and the primary action. Nothing else uses it.",
      "Status is a ring glyph whose shape changes, so color never carries status alone.",
      "Structure comes from ruled lines and whitespace. Surfaces are flat.",
      "The dark theme follows the system. A link with `?theme=light` or `?theme=dark` fixes the theme."
    ],
    "rules": [
      {
        "name": "The One Signal Rule",
        "body": "Signal red appears on the position marker and the primary action only. A new surface that needs emphasis uses ink, weight, or a rule.",
        "section": "colors"
      },
      {
        "name": "The Ring Rule",
        "body": "Status shows in the shape of the ring, never in color alone. Filled is done, a dot is in progress, a cross is blocked, a broken ring waits.",
        "section": "colors"
      },
      {
        "name": "The Line Color Rule",
        "body": "A line color names a plan. It never means good, bad, or urgent.",
        "section": "colors"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "All text is sentence case at normal letter spacing. Hierarchy comes from size and weight, never from capitals or tracking.",
        "section": "typography"
      },
      {
        "name": "The One Family Rule",
        "body": "Albert Sans is embedded as base64 and serves every text role. The page makes no network request for type.",
        "section": "typography"
      },
      {
        "name": "The Rule Over Box Rule",
        "body": "Group content with a heavy top rule and hairlines. Do not wrap it in a bordered or shadowed card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep red for the position marker and the primary action only.",
      "**Do** pair every status color with a glyph shape, and write the status in text.",
      "**Do** give each plan one line color and use it on the pill, track, ring, and group rule.",
      "**Do** separate lists with a 2px ink top rule and 1px hairlines.",
      "**Do** keep the page offline. Embed fonts and icons, and make no network request.",
      "**Do** write all labels in sentence case at normal tracking.",
      "**Do** keep text on the ground at 4.5:1 and ring strokes at 3:1 or better in both themes."
    ],
    "donts": [
      "**Do not** use a line color to mean status or priority.",
      "**Do not** put a card, a border box, or a heavy shadow around list content.",
      "**Do not** add a second typeface or a decorative display face.",
      "**Do not** use gradients, glass, or glow effects.",
      "**Do not** rely on hover for anything that a keyboard reader needs.",
      "**Do not** lighten the amber line color back to `#f2a900`. It fails 3:1 on white."
    ]
  }
}